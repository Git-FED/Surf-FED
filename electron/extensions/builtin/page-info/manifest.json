{
  "manifest_version": 3,
  "name": "Surf FED Page Info",
  "version": "1.1.0",
  "description": "Shows the title, URL, host, and page dimensions for the active tab.",
  "permissions": ["activeTab", "tabs"],
  "host_permissions": ["<all_urls>"],
  "icons": {"128": "icon.png"},
  "action": {"default_title": "Page info", "default_popup": "popup.html"},
  "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_idle"}]
}
