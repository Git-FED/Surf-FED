{
  "manifest_version": 3,
  "name": "Surf FED Dark Reader",
  "version": "1.0.0",
  "description": "Applies a conservative dark presentation to pages.",
  "host_permissions": ["<all_urls>"],
  "icons": {"128": "icon.png"},
  "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_start"}]
}
