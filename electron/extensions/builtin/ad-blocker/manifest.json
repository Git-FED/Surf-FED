{
  "manifest_version": 3,
  "name": "Surf FED Ad Blocker",
  "version": "1.1.0",
  "description": "Blocks common advertising and tracking requests in the Surf FED session.",
  "permissions": ["declarativeNetRequest"],
  "host_permissions": ["<all_urls>"],
  "icons": {"128": "icon.png"},
  "declarative_net_request": {"rule_resources": [{"id": "surf-fed-ad-rules", "enabled": true, "path": "rules.json"}]}
}
