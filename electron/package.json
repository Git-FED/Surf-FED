{
  "name": "surf-fed-electron",
  "version": "0.1.0",
  "description": "Surf FED desktop browser workspace",
  "homepage": "https://www.fedpromptly.org",
  "author": {"name": "Surf FED contributors", "email": "support@fedpromptly.com"},
  "desktopName": "surf-fed",
  "private": true,
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "test": "electron tests/run-test.js",
    "test:extensions": "node tests/validate-extensions.js",
    "dist": "electron-builder"
  },
  "devDependencies": {
    "electron": "^39.8.10",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "com.surffed.browser",
    "productName": "Surf FED",
    "files": ["**/*"],
    "asarUnpack": ["extensions/builtin/**/*", "assets/icons/**/*"],
    "directories": {"output": "dist", "buildResources": "build"},
    "win": {"target": ["portable", "nsis"]},
    "mac": {"target": ["dmg"], "category": "public.app-category.productivity"},
    "linux": {"target": ["AppImage", "deb"], "category": "Network", "maintainer": "support@fedpromptly.com"}
  }
}
