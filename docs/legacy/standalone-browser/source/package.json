{
  "name": "surf-fed-browser",
  "version": "1.1.0",
  "description": "Surf FED - an Electron web browser with custom extension support",
  "author": "Surf FED Team",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder"
  },
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.6.4"
  },
  "build": {
    "appId": "com.yourname.browser",
    "productName": "Surf FED",
    "directories": { "output": "dist" },
    "files": [
      "main.js",
      "preload.js",
      "index.html",
      "styles.css",
      "renderer.js",
      "extensions/builtin/**/*"
    ],
    "asarUnpack": [
      "extensions/builtin/**/*"
    ],
    "win": {
      "target": "portable",
      "artifactName": "Surf FED.exe"
    },
    "mac": {
      "target": "dmg",
      "artifactName": "Surf FED.dmg"
    },
    "linux": {
      "target": "AppImage",
      "artifactName": "Surf FED.AppImage"
    }
  }
}
